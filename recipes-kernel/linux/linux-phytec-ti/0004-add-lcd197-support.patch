From 2caa0c2220275477af1dbd919c7152826376453a Mon Sep 17 00:00:00 2001
From: John Ma <jma@phytec.com>
Date: Tue, 24 Feb 2026 16:12:39 -0800
Subject: [PATCH 4/6] add lcd197 support

Signed-off-by: John Ma <jma@phytec.com>
---
 arch/arm64/boot/dts/ti/Makefile               |   1 +
 .../k3-am62p5-phyboard-lynx-dsi-lcd197.dtso   | 149 ++++++++++++++++++
 arch/arm64/configs/phytec_ti_defconfig        |   1 +
 .../gpu/drm/panel/panel-lincolntech-lcd197.c  |  13 +-
 4 files changed, 158 insertions(+), 6 deletions(-)
 create mode 100644 arch/arm64/boot/dts/ti/k3-am62p5-phyboard-lynx-dsi-lcd197.dtso

diff --git a/arch/arm64/boot/dts/ti/Makefile b/arch/arm64/boot/dts/ti/Makefile
index ecf0e84a877b..a746a408d667 100644
--- a/arch/arm64/boot/dts/ti/Makefile
+++ b/arch/arm64/boot/dts/ti/Makefile
@@ -112,6 +112,7 @@ dtb-$(CONFIG_ARCH_K3) += k3-am62p5-phyflex-phyhandheld.dtb
 dtb-$(CONFIG_ARCH_K3) += k3-am62p5-phyboard-lynx-oldi-lcd185.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am62p5-phyboard-lynx-vm016-mipi.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am62p5-phyboard-lynx-m2-cc3351.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am62p5-phyboard-lynx-dsi-lcd197.dtbo
 dtb-$(CONFIG_ARCH_K3) += k3-am62p5-phyboard-lynx-dsi-lcd282.dtbo
 
 # Common overlays for SK-AM62* family of boards
diff --git a/arch/arm64/boot/dts/ti/k3-am62p5-phyboard-lynx-dsi-lcd197.dtso b/arch/arm64/boot/dts/ti/k3-am62p5-phyboard-lynx-dsi-lcd197.dtso
new file mode 100644
index 000000000000..cbb948721a8a
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am62p5-phyboard-lynx-dsi-lcd197.dtso
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0 or MIT
+/*
+ * Copyright (C) 2025 PHYTEC America LLC
+ * Author: Nathan Morrisson <nmorrisson@phytec.com>
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+#include "k3-pinctrl.h"
+
+&{/} {
+	backlight_dsi: backlight {
+		compatible = "pwm-backlight";
+		brightness-levels = <0 8 16 32 64 128 255>;
+		default-brightness-level = <6>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bl_pwm_pins_default>;
+		pwms = <&epwm2 0 50000 0>;
+	};
+};
+
+&epwm2 {
+	status = "okay";
+};
+
+&main_pmx0 {
+	/* to be checked */
+	bl_pwm_pins_default: bl-pwm-pins-default {
+		pinctrl-single,pins = <
+			AM62PX_IOPAD(0x01a8, PIN_INPUT, 0) /* (F25) MCASP0_AFSX */
+
+		>;
+	};
+
+	touch_screen_pins_default: touch-screen-pins-default {
+		pinctrl-single,pins = <
+			AM62PX_IOPAD(0x0048, PIN_INPUT, 7) /* (V25) GPMC0_AD3.GPIO0_18 */
+		>;
+	};
+
+	/* is it in use? */
+	lcd197_pins_default: lcd197-default-pins {
+		pinctrl-single,pins = <
+			AM62PX_IOPAD(0x194, PIN_INPUT, 7)	/* (D25) MCASP0_AXR3.GPIO1_7 */
+			AM62PX_IOPAD(0x198, PIN_INPUT, 7)	/* (E25) MCASP0_AXR2.GPIO1_8 */
+		>;
+	};
+};
+
+&dphy_tx0 {
+	status = "okay";
+};
+
+&dsi0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			dsi0_out: endpoint {
+				remote-endpoint = <&display_in>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			dsi0_in: endpoint {
+				remote-endpoint = <&dss1_dpi1_out>;
+			};
+		};
+	};
+
+	display: panel@0 {
+		compatible = "lincolntech,lcd197";
+		reg = <0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd197_pins_default>;
+
+		/* is it in use? */
+		enable-gpios = <&main_gpio1 7 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&main_gpio1 8 GPIO_ACTIVE_LOW>;
+
+		backlight = <&backlight_dsi>;
+		dsi-lanes = <4>;
+		panel-bpc = <8>;
+
+		port {
+			display_in: endpoint {
+				remote-endpoint = <&dsi0_out>;
+			};
+		};
+	};
+};
+
+&dss0 {
+	status = "disabled";
+};
+
+&dss1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_dpi_pins_default>;
+	status = "okay";
+};
+
+&dss1_ports {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	/* DSS1-VP1: DSI Output */
+	port@1 {
+		reg = <1>;
+
+		dss1_dpi1_out: endpoint {
+			remote-endpoint = <&dsi0_in>;
+		};
+	};
+};
+
+&main_i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	touchscreen@38 {
+		compatible = "focaltech,ft8201";
+		reg = <0x38>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_screen_pins_default>;
+
+		interrupt-parent = <&main_gpio0>;
+		interrupts = <40 IRQ_TYPE_EDGE_FALLING>;
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+
+		reset-gpios = <&gpio_exp0 4 GPIO_ACTIVE_LOW>;
+	};
+};
diff --git a/arch/arm64/configs/phytec_ti_defconfig b/arch/arm64/configs/phytec_ti_defconfig
index 418069b8aa68..cb903f38afe2 100644
--- a/arch/arm64/configs/phytec_ti_defconfig
+++ b/arch/arm64/configs/phytec_ti_defconfig
@@ -599,6 +599,7 @@ CONFIG_DRM_PANEL_BOE_TV101WUM_NL6=m
 CONFIG_DRM_PANEL_LVDS=m
 CONFIG_DRM_PANEL_ILITEK_ILI9882T=m
 CONFIG_DRM_PANEL_KHADAS_TS050=m
+CONFIG_DRM_PANEL_LINCOLNTECH_LCD197=y
 CONFIG_DRM_PANEL_MANTIX_MLAF057WE51=m
 CONFIG_DRM_PANEL_NOVATEK_NT36672E=m
 CONFIG_DRM_PANEL_RAYDIUM_RM67191=m
diff --git a/drivers/gpu/drm/panel/panel-lincolntech-lcd197.c b/drivers/gpu/drm/panel/panel-lincolntech-lcd197.c
index 032c542aab0f..be975daeebb9 100644
--- a/drivers/gpu/drm/panel/panel-lincolntech-lcd197.c
+++ b/drivers/gpu/drm/panel/panel-lincolntech-lcd197.c
@@ -150,16 +150,16 @@ static int lincoln_lcd197_panel_disable(struct drm_panel *panel)
 }
 
 static const struct drm_display_mode lcd197_mode = {
-	.clock = 154002,
+	.clock = 154000,
 	.hdisplay = 1080,
-	.hsync_start = 1080 + 20,
-	.hsync_end = 1080 + 20 + 6,
+	.hsync_start = 1080 + 70 ,
+	.hsync_end = 1080 + 70 + 6,
 	.htotal = 1080 + 204,
 	.vdisplay = 1920,
-	.vsync_start = 1920 + 4,
-	.vsync_end = 1920 + 4 + 4,
+	.vsync_start = 1920 + 10,
+	.vsync_end = 1920 + 10 + 6,
 	.vtotal = 1920 + 79,
-	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_PVSYNC,
 	.width_mm = 79,
 	.height_mm = 125,
 	.type = DRM_MODE_TYPE_DRIVER,
@@ -221,6 +221,7 @@ static int lincoln_lcd197_panel_probe(struct mipi_dsi_device *dsi)
 	if (err)
 		return err;
 
+	lcd->panel.prepare_prev_first = true;
 	drm_panel_add(&lcd->panel);
 	err = mipi_dsi_attach(dsi);
 	if (err)
-- 
2.43.0

