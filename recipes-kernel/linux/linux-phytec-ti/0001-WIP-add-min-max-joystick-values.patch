From 198664ea1d0560e285d5f676dd7cba1f1a212d39 Mon Sep 17 00:00:00 2001
From: Nathan Morrisson <nmorrisson@phytec.com>
Date: Fri, 6 Mar 2026 11:02:11 -0800
Subject: [PATCH] WIP add min/max joystick values

Signed-off-by: Nathan Morrisson <nmorrisson@phytec.com>
---
 drivers/input/joystick/phyhandheld.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/input/joystick/phyhandheld.c b/drivers/input/joystick/phyhandheld.c
index 3a5861e42204..827a34d2dcd0 100644
--- a/drivers/input/joystick/phyhandheld.c
+++ b/drivers/input/joystick/phyhandheld.c
@@ -191,6 +191,30 @@ static int phyhandheld_read_data5(struct i2c_client *client, struct phyhandheld_
 	data->j2_ad1 = be16_to_cpu(read_buf[3]);
 	data->j2_ad2 = be16_to_cpu(read_buf[4]);
 
+	if (data->j1_ad1 > 3429) {
+		data->j1_ad1 = 3429;
+	} else if (data->j1_ad1 < 700) {
+		data->j1_ad1 = 700;
+	}
+
+	if (data->j1_ad2 > 3429) {
+		data->j1_ad2 = 3429;
+	} else if (data->j1_ad2 < 700) {
+		data->j1_ad2 = 700;
+	}
+
+	if (data->j2_ad1 > 3429) {
+		data->j2_ad1 = 3429;
+	} else if (data->j2_ad1 < 700) {
+		data->j2_ad1 = 700;
+	}
+
+	if (data->j2_ad2 > 3429) {
+		data->j2_ad2 = 0x3429;
+	} else if (data->j2_ad2 < 700) {
+		data->j2_ad2 = 700;
+	}
+
 	data->j1_ad1 = (be16_to_cpu(read_buf[1]) * 3) / 2 - 1050;
 	data->j1_ad2 = (be16_to_cpu(read_buf[2]) * 3) / 2 - 1050;
 	data->j2_ad1 = (be16_to_cpu(read_buf[3]) * 3) / 2 - 1050;
-- 
