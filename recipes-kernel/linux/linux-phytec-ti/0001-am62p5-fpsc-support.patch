+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ti,pindir-d0-out-d1-in;
+	status = "okay";
+
+	adc@0 {
+		compatible = "microchip,mcp3002";
+		reg = <0>;
+		vref-supply = <&vdd_5v0_ref>;
+		spi-cpha;
+		spi-cpol;
+		#io-channel-cells = <1>;
+	};
+};
+
+&main_spi1 {	/* FPSC SPI3 */
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ti,pindir-d0-out-d1-in;
+	status = "okay";
+
+	spidev@0 {
+		spi-max-frequency = <24000000>;
+		reg = <0>;
+		compatible = "rohm,dh2228fv";
+	};
+};
+
+&main_uart0 {	/* FPSC UART1 */
+	bootph-all;
+	status = "okay";
+};
+
+&main_uart1 {	/* FPSC UART3 */
+	status = "okay";
+	bootph-all;
+};
+
+&mcu_i2c0 {		/* FPSC I2C4 */
+	clock-frequency = <400000>;
+	status = "okay";
+};
+
+&mcu_mcan0 {	/* FPSC CAN2 */
+	phys = <&can_tc2>;
+	status = "okay";
+};
+
+&mcu_mcan1 {	/* FPSC CAN3 */
+	phys = <&can_tc3>;
+	status = "okay";
+};
+
+&mcu_spi0 {		/* FPSC SPI2 */
+	#address-cells = <1>;
+	#size-cells = <0>;
+	ti,pindir-d0-out-d1-in;
+	status = "okay";
+
+	tpm@1 {
+		compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
+		reg = <1>;
+		spi-max-frequency = <10000000>;
+	};
+};
+
+&mcu_uart0 {	/* FPSC UART2 */
+     status = "okay";
+};
+
+&ospi0 {
+	status = "okay";
+
+	serial_flash: flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0x0>;
+		spi-tx-bus-width = <4>;
