+
+&cpsw3g {
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_rgmii1_pins_default>, <&main_rgmii2_pins_default>;
+};
+
+&cpsw_port2 {
+	phy-mode = "rgmii-rxid";
+	phy-handle = <&cpsw3g_phy2>;
+	status = "okay";
+};
+
+&cpsw3g_mdio {
+	cpsw3g_phy2: ethernet-phy@2 {
+		compatible = "ethernet-phy-id2000.a231", "ethernet-phy-ieee802.3-c22";
+		reg = <2>;
+		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
+		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
+		ti,min-output-impedance;
+	};
+};
+
+&main_i2c0 {	/* FPSC I2C2 */
+	clock-frequency = <400000>;
+	status = "okay";
+
+	gpio_exp1: gpio@21 {
+		pinctrl-names = "default";
+		pinctrl-0 = <>;
+		compatible = "ti,tca6416";
+		reg = <0x21>;
+		vcc-supply = <&vdd_3v3>;
+		interrupt-parent = <&main_gpio1>;
+		interrupts = <30 IRQ_TYPE_EDGE_FALLING>;
+		#gpio-cells = <2>;
+		gpio-controller;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		gpio-line-names = "VCONN_nFAULT", "X_CSI1_CTRL1",
+				   "X_CSI1_CTRL3", "X_CSI1_CTRL4",
+				   "USB-C_nINT/AUDIO_AC", "X_CSI2_CTRL1",
+				   "X_CSI2_CTRL3", "X_CSI2_CTRL4",
+				   "CLK_EN_AV", "X_W_nDISABLE1",
+				   "X_W_nDISABLE2", "X_PCIE1_nWAKE",
+				   "X_PCIE2_nWAKE", "X_UART1_nWAKE",
+				   "UART1_BT_RS_SEL", "UART1_RS232_485_SEL";
+		bootph-all;
+	};
+
+	/* TODO: STUSB4500QTR 0x28 */
+
+	eeprom@51 {
+		compatible = "atmel,24c02";
+		reg = <0x51>;
+		pagesize = <16>;
+		vcc-supply = <&vdd_1v8>;
+	};
+
+	eeprom@52 {
+		compatible = "atmel,24c02";
+		reg = <0x52>;
+		pagesize = <16>;
+		vcc-supply = <&vdd_1v8>;
+	};
+
+
+};
+
+&main_i2c1 {	/* FPSC I2C3 */
+	clock-frequency = <100000>;
+	status = "okay";
+
+	/* CSI 0x10 */
+
+	gpio_exp2: gpio@21 {
+		pinctrl-names = "default";
+		pinctrl-0 = <>;
+		compatible = "ti,tca6416";
+		reg = <0x21>;
+		vcc-supply = <&vdd_3v3>;
+		interrupt-parent = <&main_gpio0>;
+		interrupts = <20 IRQ_TYPE_EDGE_FALLING>;
+		#gpio-cells = <2>;
+		gpio-controller;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		gpio-line-names = "CAN1_STBY", "CAN2_STBY",
+				   "CAN3_STBY", "X_KEY-E_nALERT",
+				   "X_KEY-M_nALERT", "X_SDIO_nWAKE",
+				   "X_SDIO_nRESET", "HDMI_EN",
+				   "X_RTC_nINT", "LVDS1_BL_EN",
+				   "SFP_TX_FAULT", "SFP_TX_DISABLE",
+				   "SFP_MOD_ABS", "SFP_RS0",
+				   "SFP_RX_LOSS", "SFP_RS1";
+		bootph-all;
+	};
+
+	/* TUSB8042A 0x44 */
+
+	usb-typec@47 {
+		compatible = "ti,hd3ss3220";
+		reg = <0x47>;
+		pinctrl-names = "default";
+		interrupt-parent = <&gpio_exp1>;
+		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				hd3ss3220_in_ep: endpoint {
+					remote-endpoint = <&ss_ep>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				hd3ss3220_out_ep: endpoint {
+					remote-endpoint = <&usb3_role_switch>;
+				};
+			};
+		};
+	};
+
+	eeprom@51 {
+		compatible = "atmel,24c32";
+		reg = <0x51>;
+		pagesize = <32>;
+		vcc-supply = <&vdd_3v3>;
+	};
+
+	led_controller: led-controller@62 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "nxp,pca9633";
+		reg = <0x62>;
+
+		led@0 {
+			reg = <0>;
+			color = <LED_COLOR_ID_RED>;
+		};
+
+		led@1 {
+			reg = <1>;
+			color = <LED_COLOR_ID_GREEN>;
+		};
+		led@2 {
+			reg = <2>;
+			color = <LED_COLOR_ID_BLUE>;
+		};
+	};
+};
+
+&main_mcan0 {	/* FPSC CAN1 */
+	phys = <&can_tc0>;
+	status = "okay";
+};
+
