From 172caddc947dc5b085aef4d5afe0cc8d8fd0baa9 Mon Sep 17 00:00:00 2001
From: Nathan Morrisson <nmorrisson@phytec.com>
Date: Fri, 6 Mar 2026 08:17:46 -0800
Subject: [PATCH 1/3] WIP increase deadzones

Signed-off-by: Nathan Morrisson <nmorrisson@phytec.com>
---
 drivers/input/joystick/phyhandheld.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/input/joystick/phyhandheld.c b/drivers/input/joystick/phyhandheld.c
index 910bb604122a..3a5861e42204 100644
--- a/drivers/input/joystick/phyhandheld.c
+++ b/drivers/input/joystick/phyhandheld.c
@@ -196,12 +196,12 @@ static int phyhandheld_read_data5(struct i2c_client *client, struct phyhandheld_
 	data->j2_ad1 = (be16_to_cpu(read_buf[3]) * 3) / 2 - 1050;
 	data->j2_ad2 = (be16_to_cpu(read_buf[4]) * 3) / 2 - 1050;
 
-	if (data->j1_ad1 > 1800 && data->j1_ad1 < 2200 && data->j1_ad2 > 1800 && data->j1_ad2 < 2200){
+	if (data->j1_ad1 > 1500 && data->j1_ad1 < 2500 && data->j1_ad2 > 1500 && data->j1_ad2 < 2500){
 		data->j1_ad1 = 2000;
 		data->j1_ad2 = 2000;
 	}
 
-	if (data->j2_ad1 > 1800 && data->j2_ad1 < 2200 && data->j2_ad2 > 1800 && data->j2_ad2 < 2200){
+	if (data->j2_ad1 > 1500 && data->j2_ad1 < 2500 && data->j2_ad2 > 1500 && data->j2_ad2 < 2500){
 		data->j2_ad1 = 2000;
 		data->j2_ad2 = 2000;
 	}
