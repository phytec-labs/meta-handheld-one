<?xml version="1.0"?>
<server-config version="6" >

    <!-- Name of server, encode in XML if you want to use unicode characters. -->
    <server-name value="STK Server" />

    <!-- Port used in server, if you specify 0, it will use the server port specified in stk_config.xml. If yo
    <server-port value="0" />

    <!-- Game mode in server, 0 is normal race (grand prix), 1 is time trial (grand prix), 3 is normal race, 4
    <server-mode value="3" />

    <!-- Difficulty in server, 0 is beginner, 1 is intermediate, 2 is expert and 3 is supertux (the most diffi
    <server-difficulty value="0" />

    <!-- Number of grand prix tracks per game (If grand prix enabled). -->
    <gp-track-count value="3" />

    <!-- Use goal target in soccer. -->
    <soccer-goal-target value="false" />

    <!-- Enable wan server, which requires you to have an stk-addons account with a saved session. Check init-
    <wan-server value="true" />

    <!-- Enable network console, which can do for example kickban. -->
    <enable-console value="false" />

    <!-- Maximum number of players on the server, setting this to a value greater than 8 can cause performance
    <server-max-players value="8" />

    <!-- Maximum number of players in the game, all other players on the server are spectators. Specify 0 to a
    <max-players-in-game value="0" />

    <!-- Password for private server, leave empty for a public server. -->
    <private-server-password value="" />

    <!-- Message of today shown in lobby, you can enter encoded XML words here or a file.txt and let STK load
    <motd value="" />

    <!-- If this value is set to false, the server will ignore chat messages from all players. -->
    <chat value="true" />

    <!-- If client sends more than chat-consecutive-interval / 2 chats within this value (read in seconds), it
    <chat-consecutive-interval value="8" />

    <!-- Allow players to vote for which track to play. If this value is set to false, the server will randoml
    <track-voting value="true" />

    <!-- Timeout in seconds for selecting karts and (or) voting tracks in server, you may want to use a lower
    <voting-timeout value="30" />

    <!-- Timeout in seconds for validation of clients in wan, currently STK will use the stk-addons server to
    <validation-timeout value="20" />

    <!-- By default WAN server will always validate player and LAN will not, disable it to allow non-validated
    <validating-player value="true" />

    <!-- Disable it to turn off all stun related code in server, it allows for saving of server resources if y
    <firewalled-server value="true" />

    <!-- Enable to allow IPv6 connection if you have a public IPv6 address. STK currently uses dual-stack mode
    <ipv6-connection value="true" />
                                                                                                              
    <!-- No server owner in lobby which can control the starting of game or kick any players. -->             
    <owner-less value="false" />                                                                              
                                                                                                              
    <!-- Time to wait before entering kart selection screen if satisfied min-start-game-players below for owne
    <start-game-counter value="60" />                                                                         
                                                                                                              
    <!-- Clients below this value will be rejected from joining this server. It's determined by number of offi
    <official-karts-threshold value="1" />                                                                    
                                                                                                              
    <!-- Clients below this value will be rejected from joining this server. It's determined by number of offi
    <official-tracks-threshold value="0.7" />                                                                 
                                                                                                              
    <!-- Only auto start kart selection when number of connected player is larger than or equals this value, f
    <min-start-game-players value="2" />                                                                      
                                                                                                              
    <!-- Automatically end linear race game after 1st player finished for some time (currently his finished ti
    <auto-end value="false" />                                                                                
                                                                                                              
    <!-- Enable team choosing in lobby in team game (soccer and CTF). If owner-less is enabled and live-specta
    <team-choosing value="true" />                                                                            
                                                                                                              
    <!-- If strict-players is on, no duplicated online id or split screen players are allowed, which can preve
    <strict-players value="false" />                                                                          
                                                                                                              
    <!-- Server will submit ranking to stk-addons server for linear race games, you require permission for tha
    <ranked value="false" />                                                                                  
                                                                                                              
    <!-- If true, the server owner can config the difficulty and game mode in the GUI of lobby. This option ca
    <server-configurable value="false" />                                                                     
                                                                                                              
    <!-- If true, players can live join or spectate the in-progress game. Currently live joining is only avail
    <live-spectate value="true" />                                                                            
                                                                                                              
    <!-- If true, server will send its addon karts real physics (kart size, length, type, etc) to client. If f
    <real-addon-karts value="true" />                                                                         
                                                                                                              
    <!-- Time in seconds when a flag is dropped a by player in CTF returning to its own base. -->             
    <flag-return-timeout value="20" />                                                                        
                                                                                                              
    <!-- Time in seconds to deactivate a flag when it's captured or returned to own base by players. -->      
    <flag-deactivated-time value="3" />                                                                       
                                                                                                              
    <!-- Hit limit of free for all, zero to disable hit limit. -->                                            
    <hit-limit value="20" />                                                                                  
                                                                                                              
    <!-- Time limit of free for all in seconds, zero to disable time limit. -->                               
    <time-limit-ffa value="360" />                                                                            
                                                                                                              
    <!-- Capture limit of CTF, zero to disable capture limit. -->                                             
    <capture-limit value="5" />                                                                               
                                                                                                              
    <!-- Time limit of CTF in seconds, zero to disable time limit. -->                                        
    <time-limit-ctf value="600" />                                                                            
                                                                                                              
    <!-- Value used by server to automatically estimate each game time. For races, it decides the lap of each 
    <auto-game-time-ratio value="-1" />                                                                       
                                                                                                              
    <!-- Maximum ping allowed for a player (in ms), it's recommended to use default value if live-spectate is 
    <max-ping value="300" />                                                                                  
                                                                                                              
    <!-- Tolerance of jitter in network allowed (in ms), it's recommended to use default value if live-spectat
    <jitter-tolerance value="100" />                                                                          
                                                                                                              
    <!-- Kick players whose ping is above max-ping. -->                                                       
    <kick-high-ping-players value="false" />                                                                  
                                                                                                              
    <!-- Allow players exceeding max-ping to have a playable game, if enabled kick-high-ping-players will be d
    <high-ping-workaround value="true" />                                                                     
                                                                                                              
    <!-- Kick idle player which has no network activity to server for more than some seconds during game, unle
    <kick-idle-player-seconds value="60" />                                                                   
                                                                                                              
    <!-- Set how many states the server will send per second, the higher this value, the more bandwidth requir
    <state-frequency value="10" />                                                                            
                                                                                                              
    <!-- Use sql database for handling server stats and maintenance, STK needs to be compiled with sqlite3 sup
    <sql-management value="false" />                                                                          
                                                                                                              
    <!-- Database filename for sqlite to use, it can be shared for all servers created in this machine, and ST
    <database-file value="stkservers.db" />                                                                   
                                                                                                              
    <!-- Specified in millisecond for maximum time waiting in sqlite3_busy_handler. You may need a higher valu
    <database-timeout value="1000" />                                                                         
                                                                                                              
    <!-- IPv4 ban list table name, you need to create the table first, see NETWORKING.md for details, empty to
    <ip-ban-table value="ip_ban" />                                                                           
                                                                                                              
    <!-- IPv6 ban list table name, you need to create the table first, see NETWORKING.md for details, empty to
    <ipv6-ban-table value="ipv6_ban" />                                                                       
                                                                                                              
    <!-- Online ID ban list table name, you need to create the table first, see NETWORKING.md for details, emp
    <online-id-ban-table value="online_id_ban" />                                                             
                                                                                                              
    <!-- Player reports table name, which will be written when a player reports player in the network user dia
    <player-reports-table value="player_reports" />                                                           
                                                                                                              
    <!-- Days to keep player reports, older than that will be auto cleared, 0 to keep them forever. -->       
    <player-reports-expired-days value="3" />                                                                 
                                                                                                              
    <!-- IP geolocation table, you only need this table if you want to geolocate IP from non-stk-addons connec
    <ip-geolocation-table value="ip_mapping" />                                                               
                                                                                                              
    <!-- IPv6 geolocation table, you only need this table if you want to geolocate IP from non-stk-addons conn
    <ipv6-geolocation-table value="ipv6_mapping" />                                                           
                                                                                                              
    <!-- If true this server will auto add / remove AI connected with network-ai=x, which will kick N - 1 bot(
    <ai-handling value="false" />                                                                             
                                                                                                              
    <!-- If true this server will allow AI instance to be connected from anywhere. (other than LAN network onl
    <ai-anywhere value="false" />                                                                             
                                                                                                              
</server-config>                                                                                              
